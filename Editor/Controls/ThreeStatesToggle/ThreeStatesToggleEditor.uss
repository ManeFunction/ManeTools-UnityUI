.mie-fields .mie-inline-button-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 2px;
    margin-right: -1px;
}

.mie-fields .mie-inline-button-row .mie-inline-button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    width: auto;
    height: 18px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding: 0 6px;
    font-size: 11px;
}

.mie-inline-button.mie-inline-button--on {
    background-color: var(--mie-button-active);
}

.mie-navigation-menu-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mie-navigation-menu {
    background-color: #2c2c2c;
    border-width: 1px;
    border-color: #888888;
    padding: 2px 0;
    color: var(--unity-colors-default-text);
}

.mie-navigation-menu .unity-base-dropdown__item {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 1px 6px;
    color: var(--unity-colors-default-text);
}

.mie-navigation-menu .unity-base-dropdown__label {
    color: var(--unity-colors-default-text);
}

.mie-navigation-menu .unity-base-dropdown__item:hover {
    background-color: #2c5d87;
}

.mie-navigation-menu .unity-base-dropdown__checkmark {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
    visibility: hidden;
}

.mie-navigation-menu .unity-base-dropdown__item--checked > .unity-base-dropdown__checkmark {
    visibility: visible;
}
