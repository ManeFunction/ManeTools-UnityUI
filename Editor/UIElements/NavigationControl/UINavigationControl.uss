.mie-navigation-control .mie-inline-button-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 2px;
    margin-right: -1px;
}

.mie-navigation-control .mie-inline-button-row .mie-inline-button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    width: auto;
    height: 18px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding: 0 6px;
    font-size: 11px;
}

.mie-navigation-control .mie-inline-button.mie-inline-button--on {
    background-color: var(--mie-button-active);
}
