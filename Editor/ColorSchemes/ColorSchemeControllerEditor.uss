.colors-container {
    margin-top: 5px;
}

.color-group {
    margin-bottom: 2px;
}

/* One graphic slot: [color/branch | object field | +/-] */
.graphic-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
}

.lead {
    width: 40px;
    min-width: 40px;
    flex-shrink: 0;
    margin-right: 2px;
}

.lead .unity-color-field {
    width: 40px;
    min-width: 40px;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

.mie-fields .lead .unity-base-field__label {
    display: none;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
}

.mie-fields .lead .unity-base-field__input {
    margin-left: 0;
}

.branch-label {
    width: 40px;
    color: #888;
    font-size: 12px;
    -unity-text-align: middle-right;
    padding-right: 4px;
}

.graphic-field-slot {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 2px 0 0;
}

.graphic-field {
    width: 100%;
    max-width: 100%;
    margin: 0;
    min-width: 0;
}

.mie-fields .graphic-field .unity-base-field__label {
    display: none;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0;
}

.mie-fields .graphic-field .unity-base-field__input {
    margin-left: 0;
}

.row-button {
    width: 20px;
    min-width: 20px;
    height: 18px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
}
